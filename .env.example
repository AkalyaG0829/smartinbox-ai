# Database & Cache configuration
POSTGRES_USER=smartinbox_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=smartinbox_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0

# App settings
ENVIRONMENT=development
PORT=8000
API_KEY=your_secure_api_key_here

# AI Provider Configuration
# Supported providers: 'cloud' (uses OpenAI/Gemini APIs) or 'local' (uses Whisper/Tesseract/SentenceTransformers)
SPEECH_TO_TEXT_PROVIDER=cloud
OCR_PROVIDER=cloud
EMBEDDING_PROVIDER=cloud

# Cloud Provider API Keys (required if provider is set to 'cloud')
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
