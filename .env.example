# Database & Cache configuration
DATABASE_URL=postgresql://smartinbox_user:smartinbox_password@localhost:5432/smartinbox_db
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: 'cloud' (uses OpenAI/Gemini APIs) or 'local' (uses Whisper/Tesseract/SentenceTransformers)
SPEECH_TO_TEXT_PROVIDER=cloud
OCR_PROVIDER=cloud
EMBEDDING_PROVIDER=cloud

# Cloud Provider API Keys (required if provider is set to 'cloud')
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# App settings
PORT=8000
ENVIRONMENT=development
